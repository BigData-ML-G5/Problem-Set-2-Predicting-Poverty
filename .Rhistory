sinopsis<-tm_map(sinopsis,toTV,"miniserie tv")
sinopsis[[101]]$content
dtm_sinopsis<-DocumentTermMatrix(sinopsis)
#Inspeccionemos las filas 100 a 103 de esta matriz
inspect(dtm_sinopsis[100:103,])
# Quitar sparsity
dtm_sinopsis <- removeSparseTerms(dtm_sinopsis, sparse = 0.95)
inspect(dtm_sinopsis[100:103,])
p_load("proxy")
# Convertir la DTM en una matriz
dtm_matrix <- as.matrix(dtm_sinopsis)
# Calcular la similitud de coseno entre los documentos
cosine_sim <- 1 - proxy::dist(dtm_matrix, dtm_matrix, method = "cosine")
# Veamos la similitud entre la primera película y las siguientes veinte
cosine_sim[1, 1:20]
# Seleccionamos las primeras 20 filas y columnas
cosine_subset <- as.matrix(cosine_sim[1:20, 1:20])
# Heatmap base de R
heatmap(cosine_subset,
Rowv = NA, Colv = NA, # sin reordenar
revC=TRUE,
scale = "none",
col = rev(heat.colors(256)),
margins = c(5,5),
main = "Heatmap de similitud de coseno (Docs 1-20)")
# Crear función recomendadora
pelis$index<-1:nrow(pelis)
recomendador<- function(title, distancias=cosine_sim, df=pelis){
#Obtengo el indice
idx <- df$index[df$titulo==title]
#Genero un data.frame con las distancias y los títulos
recomendaciones<-data.frame(dist=distancias[idx,],indice=df$titulo)
#Ordeno las recomendaciones
recomendaciones<- recomendaciones %>% arrange(-dist)
#Retorno los títulos en el top 10
return(recomendaciones[1:10,2])
}
#Obtenemos las recomendaciones
recomendador('Las iguanas')
